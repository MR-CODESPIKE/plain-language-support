{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?i:(?:(?:CLASS|TO|TRY|REPEAT)\\b.*|IF\\b.*|ELSE(?:\\s+IF\\b.*)?|CATCH\\b.*))$",
    "decreaseIndentPattern": "^\\s*(?i:(?:END\\b.*|ELSE\\b.*|CATCH\\b.*))$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(?i:(?:CLASS|IF|REPEAT|TRY|TO)\\b)",
      "end": "^\\s*(?i:END)\\b"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|\\d+(?:\\.\\d+)?"
}
